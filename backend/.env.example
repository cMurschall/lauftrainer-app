# Server
PORT=8000
NODE_ENV=development

# Frontend origin(s), comma-separated when needed
ALLOWED_ORIGIN=http://localhost:5173

# Google Gemini API
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Reserved for the future Polar OAuth integration
POLAR_CLIENT_ID=replace-with-your-polar-client-id
POLAR_CLIENT_SECRET=replace-with-your-polar-client-secret
POLAR_REDIRECT_URI=http://localhost:8000/api/polar/callback
