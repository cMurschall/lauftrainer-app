{
  "name": "lauftrainer-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "db:migrate:local": "wrangler d1 migrations apply lauftrainer-billing --local",
    "dev": "npm run db:migrate:local && concurrently --kill-others \"npm:dev:logger\" \"npm:dev:worker\"",
    "dev:logger": "tsx scripts/local-gemini-logger.ts",
    "dev:worker": "wrangler dev",
    "build": "tsc -p tsconfig.json",
    "deploy": "wrangler deploy",
    "test": "tsx --test test/*.test.ts",
    "test:plan": "tsx scripts/evaluate-training-plans.ts",
    "test:plan:legacy": "tsx scripts/test-training-plan.ts"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "concurrently": "^10.0.4",
    "tsx": "^4.23.12",
    "typescript": "^5.8.2",
    "wrangler": "^4.30.0"
  }
}
